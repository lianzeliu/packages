#!/bin/sh
#

# Default input parameters for wrtbwmon.
runMode=0
Monitor46=4

# Some parameters for monitor process.
for46=
updatePID=
logFile=/var/log/wrtbwmon.log
lockFile=/var/lock/wrtbwmon.lock
pidFile=/var/run/wrtbwmon.pid
tmpDir=/var/tmp/wrtbwmon
interval4=0
interval6=0

# Debug parameters for readDB.awk.
mode=
DEBUG=

# Constant parameter for wrtbwmon.
binDir=/usr/sbin
dataDir=/usr/share/wrtbwmon

networkFuncs=/lib/functions/network.sh
uci=`which uci 2>/dev/null`
nslookup=`which nslookup 2>/dev/null`
nvram=`which nvram 2>/dev/null`

chains='INPUT OUTPUT FORWARD'
interfaces='eth0 tun0 br-lan' # in addition to detected WAN

# DNS server for reverse lookups provided in "DNS".
# don't perform reverse DNS lookups by default
DO_RDNS=${DNS-}

header="#mac,ip,iface,speed_in,speed_out,in,out,total,first_date,last_date"

createDbIfMissing() {
	[ ! -f "$DB" ] && echo $header > "$DB"
	[ ! -f "$DB6" ] && echo $header > "$DB6"
}

checkDbArg() {
	[ -z "$DB" ] && echo "ERROR: Missing argument 2 (database file)" && exit 1
}

checkDB() {
	[ ! -f "$DB" ] && echo "ERROR: $DB does not exist" && exit 1
	[ ! -w "$DB" ] && echo "ERROR: $DB is not writable" && exit 1
	[ ! -f "$DB6" ] && echo "ERROR: $DB6 does not exist" && exit 1
	[ ! -w "$DB6" ] && echo "ERROR: $DB6 is not writable" && exit 1
}

checkWAN() {
	[ -z "$1" ] && echo "Warning: failed to detect WAN interface."
}

lookup() {
	local MAC=$1
	local IP=$2
	local userDB=$3
	local USERSFILE=
	local USER=
	for USERSFILE in $userDB /tmp/dhcp.leases /tmp/dnsmasq.conf /etc/dnsmasq.conf /etc/hosts; do
		[ -e "$USERSFILE" ] || continue

		case $USERSFILE in
			/tmp/dhcp.leases )
			USER=$(grep -i "$MAC" $USERSFILE | cut -f4 -s -d' ')
			;;
			/etc/hosts )
			USER=$(grep "^$IP " $USERSFILE | cut -f2 -s -d' ')
			;;
			* )
			USER=$(grep -i "$MAC" "$USERSFILE" | cut -f2 -s -d,)
			;;
		esac

		[ "$USER" = "*" ] && USER=
		[ -n "$USER" ] && break

	done

	if [ -n "$DO_RDNS" -a -z "$USER" -a "$IP" != "NA" -a -n "$nslookup" ]; then
		USER=`$nslookup $IP $DNS | awk '!/server can/{if($4){print $4; exit}}' | sed -re 's/[.]$//'`
	fi

	[ -z "$USER" ] && USER=${MAC}
	echo $USER
}

detectIF() {
	local IF=
	if [ -f "$networkFuncs" ]; then
		IF=`. $networkFuncs; network_get_device netdev $1; echo $netdev`
		[ -n "$IF" ] && echo $IF && return
	fi

	if [ -n "$uci" -a -x "$uci" ]; then
		IF=`$uci get network.${1}.ifname 2>/dev/null`
		[ $? -eq 0 -a -n "$IF" ] && echo $IF && return
	fi

	if [ -n "$nvram" -a -x "$nvram" ]; then
		IF=`$nvram get ${1}_ifname 2>/dev/null`
		[ $? -eq 0 -a -n "$IF" ] && echo $IF && return
	fi
}

detectLAN() {
	[ -e /sys/class/net/br-lan ] && echo br-lan && return
	local lan=$(detectIF lan)
	[ -n "$lan" ] && echo $lan && return
}

detectWAN() {
	local wan=$(detectIF wan)
	[ -n "$wan" ] && echo $wan && return
	wan=$(ip route show 2>/dev/null | grep default | sed -re '/^default/ s/default.*dev +([^ ]+).*/\1/')
	[ -n "$wan" ] && echo $wan && return
	[ -f "$networkFuncs" ] && wan=$(. $networkFuncs; network_find_wan wan; echo $wan)
	[ -n "$wan" ] && echo $wan && return
}

lockFunc() {
	#Realize the lock function by busybox lock or flock command.
	#	if !(lock -n $lockFile) >/dev/null 2>&1; then
	#		exit 1
	#	fi
	#The following lock method is realized by other's function.

	local attempts=0
	local flag=0

	while [ "$flag" = 0 ]; do
		local tempfile=$(mktemp $tmpDir/lock.XXXXXX)
		ln $tempfile $lockFile >/dev/null 2>&1 && flag=1
		rm $tempfile

		if [ "$flag" = 1 ]; then
			[ -n "$DEBUG" ] && echo ${updatePID} "got lock after $attempts attempts"
			flag=1
		else
			sleep 1
			attempts=$(($attempts+1))
			[ -n "$DEBUG" ] && echo ${updatePID} "The $attempts attempts."
			[ "$attempts" -ge 10 ] && exit
		fi
	done
}

unlockFunc() {
	#Realize the lock function by busybox lock or flock command.
	#	lock -u $lockFile
	#	rm -f $lockFile
	#	[ -n "$DEBUG" ] && echo ${updatePID} "released lock"
	#The following lock method is realized by other's function.

	rm -f $lockFile
	[ -n "$DEBUG" ] && echo ${updatePID} "released lock"
}

# nftables 版：每个地址族一张表（ip / ip6），链结构和原来 iptables
# mangle 版一样，只换计数后端。base 链（input/output/forward，优先级
# mangle）只跳一次到 RRDIPT_* 计数链。重复添加 base 链会多出一条 jump
# 导致重复计数，所以表只在缺失时整批创建，绝不在已有表上重复加 base 链。
ensureNftTable() {
	local fam=$1
	local need=0
	local c

	nft list table $fam wrtbwmon >/dev/null 2>&1 || need=1
	if [ $need -eq 0 ]; then
		for c in input output forward; do
			nft list chain $fam wrtbwmon $c >/dev/null 2>&1 || need=1
		done
		nft list chain $fam wrtbwmon input 2>/dev/null | grep -Fq "jump RRDIPT_INPUT" || need=1
		nft list chain $fam wrtbwmon output 2>/dev/null | grep -Fq "jump RRDIPT_OUTPUT" || need=1
		nft list chain $fam wrtbwmon forward 2>/dev/null | grep -Fq "jump RRDIPT_FORWARD" || need=1
	fi
	if [ $need -eq 1 ]; then
		# 计数器就在这张表里，重建表会清零计数器；
		# nftDumpToDelta 会把因此产生的负增量钳到 0。
		nft delete table $fam wrtbwmon 2>/dev/null
		nft -f - <<EOF
table $fam wrtbwmon {
	chain RRDIPT_INPUT {
	}
	chain RRDIPT_OUTPUT {
	}
	chain RRDIPT_FORWARD {
	}
	chain input {
		type filter hook input priority mangle; policy accept;
		jump RRDIPT_INPUT
	}
	chain output {
		type filter hook output priority mangle; policy accept;
		jump RRDIPT_OUTPUT
	}
	chain forward {
		type filter hook forward priority mangle; policy accept;
		jump RRDIPT_FORWARD
	}
}
EOF
	fi
}

# 接口计数规则（nft）：INPUT 用 iifname，OUTPUT 用 oifname。
# 先查有没有再加：nft 允许重复规则，重复了会把这个接口算两遍。
newRuleIF() {
	local chain=$1
	local IF=$2
	local fam=$3

	if [ "$chain" = "OUTPUT" ]; then
		nft list chain $fam wrtbwmon RRDIPT_OUTPUT 2>/dev/null | grep -Fq "oifname \"$IF\"" || \
			nft add rule $fam wrtbwmon RRDIPT_OUTPUT oifname "$IF" counter return 2>/dev/null
	elif [ "$chain" = "INPUT" ]; then
		nft list chain $fam wrtbwmon RRDIPT_INPUT 2>/dev/null | grep -Fq "iifname \"$IF\"" || \
			nft add rule $fam wrtbwmon RRDIPT_INPUT iifname "$IF" counter return 2>/dev/null
	fi
}

# 把一个地址族的 nft 计数 dump 转成 readDB.awk 一直解析的 9 字段行
#（pkts bytes target prot opt in out source destination），字节已经算
# 成本轮增量。nft 计数器是累计值，这里绝不 reset：原来 iptables -Z
# 那套不照搬，因为 reset 一旦静默失败，后面每轮都会把累计值重算一遍
#（clientstatus 那次平方级暴涨的教训）。改用 $tmpDir/last4 / last6
# 存每条规则上次的字节数：
#   增量 = 当前 - 上次，回退时钳到 0；
#   第一次见到的 key 直接算当前值，正好是它规则建好以来（上一轮末尾
#   建的，起点是 0）的流量；ending() 删表时会连 $tmpDir 里的 last
#   文件一起清掉，两边不会错位。
# 参数：$1 = 地址族（ip/ip6），$2 = nft 原始 dump，$3 = last 文件，$4 = 增量文件
nftDumpToDelta() {
	local fam=$1
	local raw=$2
	local last=$3
	local out=$4
	local tag="0.0.0.0/0"
	[ "$fam" = "ip6" ] && tag="::/0"
	[ -f "$last" ] || : > "$last"
	# 注意：last 文件不能用 FNR==NR 当第一个输入文件读——它第一轮
	# 是空的，空文件会让第二文件的 FNR 也等于 NR，整轮都会被当成
	# last 读掉、一条增量都出不来。所以 last 在 BEGIN 里用 getline 读。
	awk -v fam="$fam" -v tag="$tag" -v lastfile="$last" '
		BEGIN {
			while ((getline line < lastfile) > 0) {
				n=split(line, a, " ")
				if (n >= 2 && a[1] != "") last[a[1]]=a[2]
			}
			close(lastfile)
		}
		/counter/ {
			pkts="0"; bytes="0"; key=""; src=tag; dst=tag; inf="*"; outf="*"
			for (i=1; i<=NF; i++) {
				if ($i == "packets") pkts=$(i+1)
				if ($i == "bytes") bytes=$(i+1)
				if ($i == "saddr") { addr=$(i+1); key="s:" addr; src=addr }
				if ($i == "daddr") { addr=$(i+1); key="d:" addr; dst=addr }
				if ($i == "iifname") { inf=$(i+1); gsub(/"/, "", inf); key="i:" inf }
				if ($i == "oifname") { outf=$(i+1); gsub(/"/, "", outf); key="o:" outf }
			}
			if (key == "") next
			cur[key]=bytes
			if (key in last) {
				delta=bytes-last[key]
				if (delta < 0) delta=0
			} else {
				delta=bytes
			}
			print pkts, delta, "RETURN", "all", "--", inf, outf, src, dst
		}
		END {
			for (k in cur) print k, cur[k] > (lastfile ".new")
		}
	' "$raw" > "$out"
	[ -f "$last.new" ] && mv "$last.new" "$last"
}

# 删过期 per-IP 规则：nft 不能按匹配条件删，只能按 handle 删。
# 由 update() 在 readDB.awk 跑完、清 tmp 之前调用，传入该地址族当前
# 有效的 ARP IP 清单。
# 参数：$1 = 地址族（ip/ip6），$2 = 地址关键字（ip/ip6），$3 = 有效 IP 清单文件
pruneNftRules() {
	local fam=$1
	local addr=$2
	local valid=$3
	local handles
	handles=$(nft -a list chain $fam wrtbwmon RRDIPT_FORWARD 2>/dev/null | awk -v valid="$valid" '
		BEGIN {
			while ((getline line < valid) > 0) {
				if (line ~ /^[0-9a-fA-F:.]+$/) arp[line]=1
			}
		}
		/counter/ {
			ip=""
			for (i=1; i<=NF; i++) {
				if ($i == "saddr" || $i == "daddr") ip=$(i+1)
			}
			if (ip != "" && !(ip in arp)) print $NF
		}
	')
	[ -n "$handles" ] || return 0
	for h in $handles; do
		nft delete rule $fam wrtbwmon RRDIPT_FORWARD handle $h 2>/dev/null
	done
}

publish() {
	# sort DB
	# busybox sort truncates numbers to 32 bits
	grep -v '^#' $DB | awk -F, '{OFS=","; a=sprintf("%f",$6/1e6); $6=""; print a,$0}' | tr -s ',' | sort -rn | awk -F, '{OFS=",";$1=sprintf("%f",$1*1e6);print}' > $tmpDir/sorted_${updatePID}.tmp

	# create HTML page
	local htmPage="$tmpDir/${pb_html##*/}"
	rm -f $htmPage
	cp $dataDir/usage.htm1 $htmPage

	while IFS=, read PEAKUSAGE_IN MAC IP IFACE SPEED_IN SPEED_OUT PEAKUSAGE_OUT TOTAL FIRSTSEEN LASTSEEN
	do
		echo "
new Array(\"$(lookup $MAC $IP $user_def)\",\"$MAC\",\"$IP\",$SPEED_IN,$SPEED_OUT,
$PEAKUSAGE_IN,$PEAKUSAGE_OUT,$TOTAL,\"$FIRSTSEEN\",\"$LASTSEEN\")," >> $htmPage
	done < $tmpDir/sorted_${updatePID}.tmp
	echo "0);" >> $htmPage

	sed "s/(date)/`date`/" < $dataDir/usage.htm2 >> $htmPage
	mv $htmPage "$pb_html"
}

updatePrepare() {
	checkDbArg
	createDbIfMissing
	checkDB
	[ -e $tmpDir ] || mkdir -p  $tmpDir

	for46="$Monitor46"
	local timeNow=$(cat /proc/uptime | awk '{print $1}')

	if [ -e "$logFile" ]; then
		local timeLast4=$(awk -F'[: ]+' '/ipv4/{print $2}' "$logFile")
		local timeLast6=$(awk -F'[: ]+' '/ipv6/{print $2}' "$logFile")
		interval4=$(awk -v now=$timeNow -v last=$timeLast4 'BEGIN{print (now-last)}');
		interval6=$(awk -v now=$timeNow -v last=$timeLast6 'BEGIN{print (now-last)}');

		for ii in 4 6; do
			[[ -n "$(echo $for46 | grep ${ii})" ]] && {
				if [[ "$(eval echo \$interval${ii})" \> "0.9" ]]; then
					sed -i "s/^ipv${ii}: [0-9\.]\{1,\}/ipv${ii}: $timeNow/ig" "$logFile"
				else
					for46=`echo "$for46" | sed "s/${ii}//g"`
				fi
			}
		done
	else
		echo -e "ipv4: $timeNow\nipv6: $timeNow" >"$logFile"
	fi
	return 0
}

update() {
	updatePID=$( sh -c 'echo $PPID' )

	lockFunc

	local wan=$(detectWAN)
	checkWAN $wan
	interfaces="$interfaces $wan"

	[ "$for46" = 4 ] && FAMS='ip'
	[ "$for46" = 6 ] && FAMS='ip6'
	[ "$for46" = 46 ] && FAMS='ip ip6'

	for fam in $FAMS ; do
		ensureNftTable $fam

		# 本机流量：INPUT/OUTPUT 接口规则，每轮都补一次（grep 去重），
		# WAN 口变了也能跟上，不用等表重建。
		for chain in INPUT OUTPUT; do
			for interface in $interfaces; do
				[ -n "$interface" ] && [ -e "/sys/class/net/$interface" ] && newRuleIF $chain $interface $fam
			done
		done

		# 抓本轮累计计数，再转成增量。增量文件名沿用原来的
		# iptables_/ip6tables_ 名字，这样下面 readDB.awk 的调用不用改。
		> $tmpDir/nftraw_${fam}_${updatePID}.tmp
		for chain in $chains; do
			nft list chain $fam wrtbwmon RRDIPT_$chain 2>/dev/null >> $tmpDir/nftraw_${fam}_${updatePID}.tmp
		done
		if [ "$fam" = "ip" ]; then
			nftDumpToDelta $fam $tmpDir/nftraw_${fam}_${updatePID}.tmp $tmpDir/last4 $tmpDir/iptables_${updatePID}.tmp
		else
			nftDumpToDelta $fam $tmpDir/nftraw_${fam}_${updatePID}.tmp $tmpDir/last6 $tmpDir/ip6tables_${updatePID}.tmp
		fi
	done

	[ -f $tmpDir/iptables_${updatePID}.tmp ] && (
		awk -v mode="$mode" -v interfaces="$interfaces" -v wanIF="$wan" -v interval=$interval4 \
		-v ipv6="0" -v nftRaw="$tmpDir/nftraw_ip_${updatePID}.tmp" -f $binDir/readDB.awk \
		$DB \
		/proc/net/arp \
		$tmpDir/iptables_${updatePID}.tmp
	)

	[ -f $tmpDir/ip6tables_${updatePID}.tmp ] && (
		echo "This file is geneated by 'ip -6 neigh'" > $tmpDir/ip6addr_${updatePID}.tmp
		`ip -6 neigh >> $tmpDir/ip6addr_${updatePID}.tmp`;

		awk -v mode="$mode" -v interfaces="$interfaces" -v wanIF="$wan" -v interval=$interval6 \
		-v ipv6="1" -v nftRaw="$tmpDir/nftraw_ip6_${updatePID}.tmp" -f $binDir/readDB.awk \
		"$DB6" \
		$tmpDir/ip6addr_${updatePID}.tmp \
		$tmpDir/ip6tables_${updatePID}.tmp
	)

	# 删过期规则：nft 只能按 handle 删，readDB.awk 里做不了，
	# 所以放这里按 handle 清。只清本轮跑过的地址族。
	if [ -f $tmpDir/iptables_${updatePID}.tmp ]; then
		awk 'NR>1 && $3 != "0x0" {print $1}' /proc/net/arp > $tmpDir/arpips4_${updatePID}.tmp
		pruneNftRules ip ip $tmpDir/arpips4_${updatePID}.tmp
	fi
	if [ -f $tmpDir/ip6tables_${updatePID}.tmp ] && [ -f $tmpDir/ip6addr_${updatePID}.tmp ]; then
		awk '$6 != "FAILED" && $6 != "INCOMPLETE" && substr($1,1,1) != "f" && substr($1,1,1) != "d" {print $1}' $tmpDir/ip6addr_${updatePID}.tmp > $tmpDir/arpips6_${updatePID}.tmp
		pruneNftRules ip6 ip6 $tmpDir/arpips6_${updatePID}.tmp
	fi

	[ "$Monitor46" = 46 ] && (
		cp $DB $DB46
		cat $DB6 >> $DB46
		awk -f $binDir/readDB.awk "$DB46"
	)

	[ -n "$pb_html" ] && publish

	rm -f $tmpDir/*_${updatePID}.tmp
	unlockFunc
}

renamefile() {
	local base=$(basename -- "$1")
	local ext=$([ -z "${base/*.*/}"  ] && echo ".${base##*.}" || echo '')
	local base="${base%.*}"
	echo "$(dirname $1)/${base}$2$ext" && return
}

ending() {
	# 整张表删掉就是清理，比原来 iptables-save 过滤 RRDIPT 再 restore 更干净。
	# $tmpDir 一起清掉，last4/last6 也随之失效，下次启动计数从 0 开始，不会错位。
	nft delete table ip wrtbwmon 2>/dev/null
	nft delete table ip6 wrtbwmon 2>/dev/null

	if checkPid $pidFile; then
		local pid=$( cat $pidFile )
		rm -rf $lockFile $logFile $pidFile $tmpDir/*
		kill -9 $pid >> /dev/null 2>&1
	fi
	echo "exit!!"
}

checkPid() {
	[ -e "$1" ] && local pid=$(cat $1) || return 1
	[ -d "/proc/$pid" ] && {
		[ -n "$( cat /proc/$pid/cmdline | grep wrtbwmon )" ] && return 0
	}
	return 1
}

sleepProcess() {
	sleep 1m
	kill -CONT $1 >>/dev/null 2>&1
}

loop() {
	trap 'ending' INT TERM HUP QUIT
	if checkPid $pidFile; then
		echo "Another wrtbwmon is on running!!!"
	else
		local loopPID=$( sh -c 'echo $PPID' )
		local SPID=
		echo $loopPID > $pidFile
		while true ;do
			[ -n "$SPID" ] && kill -9 $SPID >>/dev/null 2>&1
			sleepProcess $loopPID &
			SPID=$!
			updatePrepare && update
			kill -STOP $loopPID >>/dev/null 2>&1
		done
	fi
	trap INT TERM HUP QUIT
}

tips() {
	echo \
"Usage: $0 [options...]
Options:
   -k 			Exit the wrtbwmon!
   -f dbfile	Set the DB file path
   -u usrfile	Set the user_def file path
   -p htmlfile	Set the publish htm file path
   -d			Enter the foreground mode.
   -D			Enter the daemo mode.
   -4			Listen to ipv4 only.
   -6			Listen to ipv6 only.
   -46			Listen to ipv4 and ipv6.

Note: [user_file] is an optional file to match users with MAC addresses.
	   Its format is \"00:MA:CA:DD:RE:SS,username\", with one entry per line."
}

############################################################

while [ $# != 0 ];do
	case $1 in
		"-k" )
			/etc/init.d/wrtbwmon stop
			exit 0
		;;
		"-f" )
			shift
			if [ $# -gt 0 ];then
				DB=$1
				DB6="$(renamefile $DB .6)"
				DB46="$(renamefile $DB .46)"
			else
				echo "No db file path seted, exit!!"
				exit 1
			fi
		;;
		"-u")
			shift
			if [ $# -gt 0 ];then
				user_def=$1
			else
				echo "No user define file path seted, exit!!"
				exit 1
			fi
		;;

		"-p")
			shift
			if [ $# -gt 0 ];then
				pb_html=$1
			else
				echo "No publish html file path seted, exit!!"
				exit 1
			fi
		;;

		"-d")
			runMode=1
		;;

		"-D")
			runMode=2
		;;

		"-4")
			Monitor46=4
		;;

		"-6")
			Monitor46=6
		;;

		"-46")
			Monitor46=46
		;;

		"&&" | "||" | ";")
			break
		;;

		"*")
			tips
		;;
	esac

	shift
done

if [ "$runMode" = '1' ]; then
	loop
elif [ "$runMode" = '2' ]; then
	loop >>/dev/null 2>&1 &
else
	updatePrepare && update
fi
